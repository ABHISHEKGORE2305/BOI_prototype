# Copy to .env. Used by local development and by docker compose.

# --- LLM reports (needed by the worker consuming the "llm" queue) ----------
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# LLM_MAX_RETRIES=3

# --- Authentication ----------------------------------------------------------
# Comma-separated "name:key" pairs. Leave empty to disable auth (dev only).
# API_KEYS=alice:change-me-1,bob:change-me-2
# UPLOAD_RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_BACKEND=redis   # or "memory" (per API process)

# --- Local development (docker compose sets these itself) --------------------
REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=sqlite:///./malware.db
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=100
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Worker ------------------------------------------------------------------
# ANALYSIS_TIME_LIMIT=600
# RESULT_RETENTION_DAYS=30
# WORKER_METRICS_PORT=0

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# --- docker compose only -----------------------------------------------------
# POSTGRES_PASSWORD=nexus
# FRONTEND_PORT=8080
