# API base URL. Default "/api/v1" goes through the Vite dev proxy / nginx.
# VITE_API_URL=http://127.0.0.1:8000/api/v1

# Where the dev server proxies /api (default http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Client-side upload size check; keep in sync with the API's MAX_UPLOAD_MB
# VITE_MAX_UPLOAD_MB=100
